# Force the browser to always revalidate index.html — prevents blank page on repeat mobile visits
/
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/resume/
  Cache-Control: no-cache, no-store, must-revalidate

/resume/index.html
  Cache-Control: no-cache, no-store, must-revalidate

# JS/CSS assets have hashed filenames so they can be cached aggressively
/assets/*
  Cache-Control: public, max-age=31536000, immutable
